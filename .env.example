# LLM provider configuration (see llm/provider.py)
# Supported values: "deterministic" (default, fully offline, no API calls) | "anthropic"
LLM_PROVIDER=deterministic

# Only required if LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Guardrails
HIGH_IMPACT_REQUIRES_APPROVAL=true

# Observability
LOG_LEVEL=INFO
